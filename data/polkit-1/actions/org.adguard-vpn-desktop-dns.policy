<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>ADGuard VPN Desktop community project</vendor>
  <vendor_url>https://github.com/1919013/adguard-vpn-desktop</vendor_url>
  <action id="org.adguard-vpn-desktop.dns">
    <description>Temporarily manage DNS for AdGuard VPN Desktop</description>
    <message>Authentication is required to temporarily change active DNS settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/adguard-vpn-desktop-dns-helper</annotate>
  </action>
</policyconfig>
